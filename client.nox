# client.nox — Reusable HTTP Client session with defaults, auth, cookies, and retry orchestration.

import nox.time
import nox.url
import nox.http
from nox.http import client_pool, client_idle_connections
import headers
from headers import Headers, headers_from_dict
import url
from url import resolve_url
import auth
from auth import BasicAuth, BearerAuth
import cookies
from cookies import CookieJar
import retry
from retry import RetryPolicy, parse_retry_after_ms
import response
from response import Response
import request
from request import Request
import transport
from transport import Transport, TransportAdapter, configure_http3, HTTP3_SCOPE
import codec
from codec import ContentDecoder, decode_response_with
import multipart
from multipart import MultipartEncoder, MultipartFile, file_from_path
import ssrf
from ssrf import SSRFPolicy, HostResolver
import stream
from stream import StreamResponse, UploadStream
import errors
from errors import RetryExhaustedError, TransportError, UnsupportedFeatureError
import nox.strings
import nox.url
from nox.url import URL

# The Nox runtime connection pool is shared by the whole process.
CONNECTION_POOL_SCOPE: str = "process"

def is_same_origin(url1: str, url2: str) -> bool:
    u1: URL = nox.url.parse(url1)
    u2: URL = nox.url.parse(url2)
    if u1.scheme != u2.scheme:
        return False
    if u1.host != u2.host:
        return False
    p1: int = u1.port
    if p1 <= 0:
        if u1.scheme == "https":
            p1 = 443
        else:
            p1 = 80
    p2: int = u2.port
    if p2 <= 0:
        if u2.scheme == "https":
            p2 = 443
        else:
            p2 = 80
    return p1 == p2

class Client:
    base_url: str
    default_headers: Headers
    basic_auth: BasicAuth | None
    bearer_auth: BearerAuth | None
    cookies: CookieJar | None
    retry_policy: RetryPolicy | None
    raise_on_status: bool
    max_redirects: int
    timeout_ms: int
    ssrf_policy: SSRFPolicy | None
    transport: Transport
    content_decoder: ContentDecoder | None
    advertise_decoder_encoding: bool

    def __init__(
        self: Client,
        base_url: str = "",
        raise_for_status: bool = False,
        max_redirects: int = 5,
        timeout_ms: int = 0,
        ssrf_policy: SSRFPolicy | None = None
    ) -> None:
        self.base_url = base_url
        self.default_headers = Headers()
        self.default_headers.set("User-Agent", "Nova/0.7.1")
        self.default_headers.set("Accept", "*/*")
        self.basic_auth = None
        self.bearer_auth = None
        self.cookies = None
        self.retry_policy = None
        self.raise_on_status = raise_for_status
        self.max_redirects = max_redirects
        self.timeout_ms = timeout_ms
        self.ssrf_policy = ssrf_policy
        self.transport = TransportAdapter()
        self.content_decoder = None
        self.advertise_decoder_encoding = False

    # SCOPE: the Nox runtime pool is PROCESS-WIDE (nox.http.client_pool). Calling this on any
    # Client reconfigures the pool for EVERY Client / request in the process; connections are
    # keyed per origin by the runtime, never shared across different hosts. A per-Client pool
    # is not possible without runtime support (NOX_LIMITATIONS.md §17).
    def set_connection_pool(self: Client, max_idle: int = 32, idle_timeout_ms: int = 90000) -> Client:
        client_pool(max_idle, idle_timeout_ms)
        return self

    # Idle connections in the PROCESS-WIDE pool (not just this Client's).
    def get_idle_connections(self: Client) -> int:
        return client_idle_connections()

    def connection_pool_scope(self: Client) -> str:
        return CONNECTION_POOL_SCOPE

    def set_ssrf_policy(self: Client, policy: SSRFPolicy) -> Client:
        self.ssrf_policy = policy
        return self

    def set_timeout(self: Client, timeout_ms: int) -> Client:
        self.timeout_ms = timeout_ms
        return self

    def set_max_redirects(self: Client, n: int) -> Client:
        self.max_redirects = n
        return self

    def set_header(self: Client, name: str, value: str) -> Client:
        self.default_headers.set(name, value)
        return self

    def set_basic_auth(self: Client, username: str, password: str) -> Client:
        self.basic_auth = BasicAuth(username, password)
        self.bearer_auth = None
        return self

    def set_bearer_auth(self: Client, token: str) -> Client:
        self.bearer_auth = BearerAuth(token)
        self.basic_auth = None
        return self

    def enable_cookies(self: Client) -> Client:
        if self.cookies is None:
            self.cookies = CookieJar()
        return self

    # Dependency injection point: replace the nox.http-backed transport (e.g. MockTransport in tests).
    def set_transport(self: Client, t: Transport) -> Client:
        self.transport = t
        return self

    def set_retry_policy(self: Client, policy: RetryPolicy) -> Client:
        self.retry_policy = policy
        return self

    # SCOPE: nox.http.set_http3 is PROCESS-WIDE (Alt-Svc discovery for HTTPS origins; falls back
    # transparently to HTTP/2 / HTTP/1.1 if unavailable or UDP 443 is blocked).
    def set_http3(self: Client, enabled: bool) -> Client:
        configure_http3(enabled)
        return self

    def http3_scope(self: Client) -> str:
        return HTTP3_SCOPE

    # Opt-in pluggable response decoder (e.g. FallbackContentDecoder on WASM/mobile, or
    # brotli_codec.BrotliDecoder on desktop). Set `advertise_accept_encoding=True` to automatically
    # advertise the decoder's `Accept-Encoding` token when not already specified per-request.
    def set_content_decoder(self: Client, decoder: ContentDecoder, advertise_accept_encoding: bool = False) -> Client:
        self.content_decoder = decoder
        self.advertise_decoder_encoding = advertise_accept_encoding
        return self

    def _prepare_request(
        self: Client,
        method: str,
        url_or_path: str,
        payload: str,
        content_type_default: str,
        params: dict[str, str] | None,
        headers: dict[str, str] | None,
        timeout_ms: int
    ) -> Request:
        full_url: str = resolve_url(self.base_url, url_or_path, params)

        req_headers: Headers = self.default_headers.clone()
        if headers is not None:
            req_headers.merge_dict(headers)

        b_auth: BasicAuth | None = self.basic_auth
        if b_auth is not None:
            b_auth.apply(req_headers)

        tok_auth: BearerAuth | None = self.bearer_auth
        if tok_auth is not None:
            tok_auth.apply(req_headers)

        jar: CookieJar | None = self.cookies
        if jar is not None:
            jar.apply_to_request(full_url, req_headers)

        dec: ContentDecoder | None = self.content_decoder
        if dec is not None and self.advertise_decoder_encoding:
            if not req_headers.has("Accept-Encoding"):
                enc_hdr: str = dec.accept_encoding()
                if len(enc_hdr) > 0:
                    req_headers.set("Accept-Encoding", enc_hdr)

        if len(content_type_default) > 0 and not req_headers.has("Content-Type"):
            req_headers.set("Content-Type", content_type_default)

        eff_timeout: int = self.timeout_ms
        if timeout_ms >= 0:
            eff_timeout = timeout_ms

        return Request(method, full_url, req_headers, payload, eff_timeout)

    def _compute_retry_delay_ms(self: Client, pol: RetryPolicy, attempt: int, resp_headers: Headers) -> int:
        delay: int = pol.next_delay_ms(attempt)
        # Respect Retry-After header if present (AGENTS.md §13): delta-seconds or HTTP-date
        retry_after_str: str = resp_headers.get("Retry-After", "")
        if len(retry_after_str) > 0:
            ra_ms: int = parse_retry_after_ms(retry_after_str, nox.time.now_ms() // 1000)
            if ra_ms > 0:
                delay = ra_ms
        # Cap delay to max_backoff_ms to prevent sleep DoS
        if delay > pol.max_backoff_ms:
            delay = pol.max_backoff_ms
        return delay

    def _build_redirect_request(
        self: Client,
        current_req: Request,
        status_code: int,
        resp_headers: Headers,
        s_pol: SSRFPolicy | None
    ) -> Request:
        loc: str = resp_headers.get("Location")
        next_url: str = resolve_url(current_req.url, loc)

        # Validate SSRF defense policy on redirect target (prevents open-redirect SSRF bypasses)
        if s_pol is not None:
            s_pol.validate_target(next_url)

        same_origin: bool = is_same_origin(current_req.url, next_url)
        next_headers: Headers = current_req.headers.clone()

        # SECURITY CRITICAL (AGENTS.md §10 & §11):
        # Strip Authorization, Proxy-Authorization, and Cookie on cross-origin redirects
        if not same_origin:
            next_headers.delete("Authorization")
            next_headers.delete("Proxy-Authorization")
            next_headers.delete("Cookie")

        # Handle 303 See Other or 301/302 POST -> GET
        next_method: str = current_req.method
        next_body: str = current_req.body
        if status_code == 303 or ((status_code == 301 or status_code == 302) and current_req.method == "POST"):
            next_method = "GET"
            next_body = ""
            next_headers.delete("Content-Type")

        # Apply cookies for new URL destination
        jar2: CookieJar | None = self.cookies
        if jar2 is not None:
            next_headers.delete("Cookie")
            jar2.apply_to_request(next_url, next_headers)

        return Request(next_method, next_url, next_headers, next_body, current_req.timeout_ms)

    def send(self: Client, req: Request) -> Response:
        # Validate SSRF defense policy on initial request target
        s_pol: SSRFPolicy | None = self.ssrf_policy
        if s_pol is not None:
            s_pol.validate_target(req.url)

        pol: RetryPolicy | None = self.retry_policy
        current_req: Request = req
        redirect_count: int = 0
        attempt: int = 0
        last_error_msg: str = ""

        while True:
            res: Response | None = None

            while True:
                try:
                    r: Response = self.transport.execute(current_req)
                    res = r

                    jar: CookieJar | None = self.cookies
                    if jar is not None:
                        jar.extract_from_response(current_req.url, r.headers)

                    if pol is not None:
                        if pol.should_retry_status(current_req.method, attempt, r.status_code):
                            attempt = attempt + 1
                            nox.time.sleep_ms(self._compute_retry_delay_ms(pol, attempt, r.headers))
                            continue
                    break
                except TransportError as te:
                    last_error_msg = str(te)
                    if pol is not None:
                        if pol.should_retry_error(current_req.method, attempt):
                            attempt = attempt + 1
                            nox.time.sleep_ms(pol.next_delay_ms(attempt))
                            continue
                    raise te

            # Handle Redirects (301, 302, 303, 307, 308)
            if res is not None:
                final_res: Response = res
                if self.max_redirects > 0 and final_res.is_redirect() and final_res.headers.has("Location"):
                    if redirect_count >= self.max_redirects:
                        raise TransportError("Too many redirects: exceeded maximum of " + str(self.max_redirects))
                    redirect_count = redirect_count + 1
                    current_req = self._build_redirect_request(current_req, final_res.status_code, final_res.headers, s_pol)
                    continue

                dec: ContentDecoder | None = self.content_decoder
                if dec is not None:
                    final_res = decode_response_with(final_res, dec, True)

                if self.raise_on_status:
                    final_res.raise_for_status()

                return final_res

        raise RetryExhaustedError(attempt, "Retries exhausted: " + last_error_msg)

    def request(
        self: Client,
        method: str,
        url_or_path: str,
        body: str = "",
        json: str = "",
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        payload: str = body
        ct: str = ""
        if len(json) > 0:
            payload = json
            ct = "application/json"
        req: Request = self._prepare_request(method, url_or_path, payload, ct, params, headers, timeout_ms)
        return self.send(req)

    def get(
        self: Client,
        url: str,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("GET", url, "", "", params, headers, timeout_ms)

    def post(
        self: Client,
        url: str,
        body: str = "",
        json: str = "",
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("POST", url, body, json, params, headers, timeout_ms)

    def post_json(
        self: Client,
        url: str,
        json_str: str,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("POST", url, "", json_str, params, headers, timeout_ms)

    def post_form(
        self: Client,
        url: str,
        data: dict[str, str],
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        encoded_form: str = nox.url.query_encode(data)
        form_headers: dict[str, str] = {"Content-Type": "application/x-www-form-urlencoded"}
        if headers is not None:
            for k in headers:
                form_headers[k] = headers[k]
        return self.request("POST", url, encoded_form, "", params, form_headers, timeout_ms)

    def post_multipart(
        self: Client,
        url: str,
        encoder: MultipartEncoder,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        body: str = encoder.build()
        mp_headers: dict[str, str] = {"Content-Type": encoder.content_type()}
        if headers is not None:
            for k in headers:
                mp_headers[k] = headers[k]
        return self.request("POST", url, body, "", params, mp_headers, timeout_ms)

    def put(
        self: Client,
        url: str,
        body: str = "",
        json: str = "",
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("PUT", url, body, json, params, headers, timeout_ms)

    def patch(
        self: Client,
        url: str,
        body: str = "",
        json: str = "",
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("PATCH", url, body, json, params, headers, timeout_ms)

    def delete(
        self: Client,
        url: str,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("DELETE", url, "", "", params, headers, timeout_ms)

    def head(
        self: Client,
        url: str,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("HEAD", url, "", "", params, headers, timeout_ms)

    def options(
        self: Client,
        url: str,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> Response:
        return self.request("OPTIONS", url, "", "", params, headers, timeout_ms)

    # Streaming download pipeline: shares SSRF, retry, redirect, CookieJar, and cleanup semantics with send().
    def stream(
        self: Client,
        method: str,
        url: str,
        body: str = "",
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> StreamResponse:
        current_req: Request = self._prepare_request(method, url, body, "", params, headers, timeout_ms)

        s_pol: SSRFPolicy | None = self.ssrf_policy
        if s_pol is not None:
            s_pol.validate_target(current_req.url)

        pol: RetryPolicy | None = self.retry_policy
        redirect_count: int = 0
        attempt: int = 0
        last_error_msg: str = ""

        while True:
            opened: StreamResponse | None = None

            while True:
                try:
                    s_resp: StreamResponse = self.transport.stream(current_req)
                    try:
                        jar: CookieJar | None = self.cookies
                        if jar is not None:
                            jar.extract_from_response(current_req.url, s_resp.headers)
                    except Exception as jar_err:
                        s_resp.close()
                        raise jar_err

                    if pol is not None:
                        if pol.should_retry_status(current_req.method, attempt, s_resp.status_code):
                            retry_delay: int = self._compute_retry_delay_ms(pol, attempt + 1, s_resp.headers)
                            s_resp.close()
                            attempt = attempt + 1
                            nox.time.sleep_ms(retry_delay)
                            continue
                    opened = s_resp
                    break
                except TransportError as te:
                    last_error_msg = str(te)
                    if pol is not None:
                        if pol.should_retry_error(current_req.method, attempt):
                            attempt = attempt + 1
                            nox.time.sleep_ms(pol.next_delay_ms(attempt))
                            continue
                    raise te

            if opened is not None:
                final_stream: StreamResponse = opened
                is_redir: bool = (final_stream.status_code >= 300 and final_stream.status_code <= 399)
                if self.max_redirects > 0 and is_redir and final_stream.headers.has("Location"):
                    try:
                        if redirect_count >= self.max_redirects:
                            raise TransportError("Too many redirects: exceeded maximum of " + str(self.max_redirects))
                        redirect_count = redirect_count + 1
                        next_req: Request = self._build_redirect_request(current_req, final_stream.status_code, final_stream.headers, s_pol)
                        final_stream.close()
                        current_req = next_req
                        continue
                    except Exception as redir_err:
                        final_stream.close()
                        raise redir_err

                if self.raise_on_status:
                    try:
                        final_stream.raise_for_status()
                    except Exception as status_err:
                        final_stream.close()
                        raise status_err

                return final_stream

        raise RetryExhaustedError(attempt, "Retries exhausted: " + last_error_msg)

    # Streaming request body upload (chunked when content_length == -1, fixed-size when >= 0).
    def stream_upload(
        self: Client,
        method: str,
        url: str,
        content_length: int = -1,
        params: dict[str, str] | None = None,
        headers: dict[str, str] | None = None,
        timeout_ms: int = -1
    ) -> UploadStream:
        req: Request = self._prepare_request(method, url, "", "", params, headers, timeout_ms)

        s_pol: SSRFPolicy | None = self.ssrf_policy
        if s_pol is not None:
            s_pol.validate_target(req.url)

        up: UploadStream = self.transport.stream_upload(req, content_length)
        up.raise_on_status = self.raise_on_status
        up.cookie_jar = self.cookies
        up.content_decoder = self.content_decoder
        return up

# Factory for pre-hardened, defense-in-depth clients (e.g. for fetching user-supplied URLs).
# Enables default SSRF blocking, sets 15s timeout, limits redirects to 3, and enables raise_for_status.
# If `resolver` is supplied, it is attached to the SSRFPolicy to validate all resolved IP addresses.
# Pass `require_dns_or_allowlist=True` to reject unverified public hostnames when no resolver is configured.
def create_safe_client(
    base_url: str = "",
    timeout_ms: int = 15000,
    max_redirects: int = 3,
    ssrf_policy: SSRFPolicy | None = None,
    resolver: HostResolver | None = None,
    require_dns_or_allowlist: bool = False
) -> Client:
    p: SSRFPolicy = SSRFPolicy()
    if ssrf_policy is not None:
        p = ssrf_policy
    if resolver is not None:
        p.set_resolver(resolver)
    if require_dns_or_allowlist:
        p.set_require_dns_or_allowlist(True)
    c: Client = Client(
        base_url=base_url,
        raise_for_status=True,
        max_redirects=max_redirects,
        timeout_ms=timeout_ms,
        ssrf_policy=p
    )
    return c
