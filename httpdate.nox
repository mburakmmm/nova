# httpdate.nox — HTTP-date parsing (RFC 9110 §5.6.7: IMF-fixdate, RFC 850, asctime) and
# RFC 6265 §5.1.1-style tolerant cookie dates. Returns Unix epoch SECONDS, or -1 when invalid.

import nox.strings

def _month_index(tok: str) -> int:
    if len(tok) < 3:
        return -1
    m: str = nox.strings.lower(tok[0:3])
    names: list[str] = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    i: int = 0
    while i < 12:
        if names[i] == m:
            return i + 1
        i = i + 1
    return -1

def _all_digits(s: str) -> bool:
    if len(s) == 0:
        return False
    i: int = 0
    while i < len(s):
        b: int = nox.strings.byte_at(s, i)
        if b < 48 or b > 57:
            return False
        i = i + 1
    return True

# Days since 1970-01-01 for a proleptic Gregorian civil date (Howard Hinnant's algorithm).
def days_from_civil(y_in: int, m: int, d: int) -> int:
    y: int = y_in
    if m <= 2:
        y = y - 1
    era: int = y // 400
    yoe: int = y - era * 400
    mp: int = m + 9
    if m > 2:
        mp = m - 3
    doy: int = (153 * mp + 2) // 5 + d - 1
    doe: int = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

def _days_in_month(y: int, m: int) -> int:
    if m == 2:
        leap: bool = (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0)
        if leap:
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31

def parse_http_date(s_in: str) -> int:
    s: str = nox.strings.trim(s_in)
    if len(s) == 0:
        return -1
    # Normalise delimiters to spaces.
    norm: str = ""
    i: int = 0
    while i < len(s):
        ch: str = s[i:i + 1]
        if ch == "," or ch == "-" or ch == "\t":
            norm = norm + " "
        else:
            norm = norm + ch
        i = i + 1
    toks: list[str] = nox.strings.split(norm, " ")

    hour: int = -1
    minute: int = -1
    sec: int = -1
    day: int = -1
    month: int = -1
    year: int = -1
    found_time: bool = False

    j: int = 0
    while j < len(toks):
        t: str = toks[j]
        j = j + 1
        if len(t) == 0:
            continue
        if (not found_time) and nox.strings.index_of(t, ":") > 0:
            hp: list[str] = nox.strings.split(t, ":")
            if len(hp) == 3 and _all_digits(hp[0]) and _all_digits(hp[1]) and _all_digits(hp[2]):
                hour = int(hp[0])
                minute = int(hp[1])
                sec = int(hp[2])
                found_time = True
            continue
        if month < 0 and not _all_digits(t):
            mi: int = _month_index(t)
            if mi > 0:
                month = mi
            continue
        if _all_digits(t):
            if day < 0 and len(t) <= 2:
                day = int(t)
            elif year < 0 and (len(t) == 2 or len(t) == 4):
                year = int(t)
                if len(t) == 2:
                    if year >= 70:
                        year = year + 1900
                    else:
                        year = year + 2000

    if (not found_time) or month < 0 or day < 0 or year < 0:
        return -1
    if year < 1601 or hour > 23 or minute > 59 or sec > 60:
        return -1
    if day < 1 or day > _days_in_month(year, month):
        return -1
    days: int = days_from_civil(year, month, day)
    return days * 86400 + hour * 3600 + minute * 60 + sec
