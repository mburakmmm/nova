# tests/unit/client_config_test.nox — Test Client configuration, default headers, and instance isolation.

import nox.test
import client
from client import Client, create_safe_client
import nova
from nova import safe_client
import ssrf
from ssrf import StaticResolver, SSRFPolicy

# 1. Defaults
c1: Client = Client("https://api.example.com")
nox.test.assert_eq_str(c1.base_url, "https://api.example.com", "base_url set")
nox.test.assert_eq_str(c1.default_headers.get("User-Agent"), "Nova/0.6.2", "default User-Agent header")
nox.test.assert_eq_str(c1.default_headers.get("Accept"), "*/*", "default Accept header")
nox.test.assert_eq_int(c1.timeout_ms, 0, "default timeout_ms is 0 (unlimited)")

c1.set_timeout(3000)
nox.test.assert_eq_int(c1.timeout_ms, 3000, "set_timeout updates timeout_ms")

# 2. Custom header chaining
c1.set_header("X-App-ID", "app_12345")
nox.test.assert_eq_str(c1.default_headers.get("X-App-ID"), "app_12345", "custom header set on client")

# 3. Instance isolation: c2 does not inherit c1's custom headers
c2: Client = Client("https://other.example.com")
nox.test.assert_true(not c2.default_headers.has("X-App-ID"), "c2 is isolated from c1 headers")

# 4. Auth configuration
c1.set_bearer_auth("token_xyz_99")
nox.test.assert_true(c1.bearer_auth is not None, "bearer_auth configured")
nox.test.assert_true(c1.basic_auth is None, "basic_auth is None when bearer is set")

c1.set_basic_auth("user1", "pass1")
nox.test.assert_true(c1.basic_auth is not None, "basic_auth configured")
nox.test.assert_true(c1.bearer_auth is None, "bearer_auth cleared when basic is set")

# 5. Cookie jar enablement
c1.enable_cookies()
nox.test.assert_true(c1.cookies is not None, "cookie jar enabled on client")
nox.test.assert_true(c2.cookies is None, "cookie jar remains None on unconfigured client")

# 6. Safe client factory
sc: Client = create_safe_client("https://safe.example.com")
nox.test.assert_eq_str(sc.base_url, "https://safe.example.com", "safe client base_url")
nox.test.assert_true(sc.raise_on_status, "safe client has raise_on_status enabled")
nox.test.assert_eq_int(sc.timeout_ms, 15000, "safe client default timeout 15000ms")
nox.test.assert_eq_int(sc.max_redirects, 3, "safe client default max_redirects 3")
nox.test.assert_true(sc.ssrf_policy is not None, "safe client has ssrf_policy enabled by default")

# safe_client via nova facade with custom bounds
sc2: Client = safe_client("https://safe2.example.com", timeout_ms=5000, max_redirects=2)
nox.test.assert_eq_int(sc2.timeout_ms, 5000, "custom safe timeout")
nox.test.assert_eq_int(sc2.max_redirects, 2, "custom safe max_redirects")
nox.test.assert_true(sc2.ssrf_policy is not None, "custom safe client has ssrf_policy")

# safe_client with attached HostResolver
res_cfg: StaticResolver = StaticResolver()
res_cfg.add("allowed.test", ["93.184.216.34"])
sc3: Client = safe_client("https://safe3.example.com", resolver=res_cfg)
nox.test.assert_true(sc3.ssrf_policy is not None, "sc3 has ssrf_policy")
p3: SSRFPolicy | None = sc3.ssrf_policy
if p3 is not None:
    nox.test.assert_true(p3.resolver is not None, "sc3 ssrf_policy has attached resolver")

print("client_config_test passed")
