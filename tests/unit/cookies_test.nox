# tests/unit/cookies_test.nox — Test cookie jar storage, domain boundary, path isolation, and HTTPS security.

import nox.test
import cookies
from cookies import CookieJar, Cookie
import headers
from headers import Headers
import errors
from errors import InvalidHeaderError

# 1. Basic Set & Get
jar: CookieJar = CookieJar()
jar.set("session", "abc123xyz", "example.com", "/")
jar.set("user_id", "42", "example.com", "/")

val_sess: str | None = jar.get("session")
nox.test.assert_true(val_sess is not None, "session cookie is not None")
if val_sess is not None:
    nox.test.assert_eq_str(val_sess, "abc123xyz", "session cookie retrieved")

val_uid: str | None = jar.get("user_id")
nox.test.assert_true(val_uid is not None, "user_id cookie is not None")
if val_uid is not None:
    nox.test.assert_eq_str(val_uid, "42", "user_id cookie retrieved")

nox.test.assert_true(jar.get("nonexistent") is None, "nonexistent cookie returns None")

# 2. Strict Domain Boundary (Prevents notexample.com matching example.com)
jar.set("domain_token", "dom_tok_1", "example.com", "/")

# Subdomain accepted
hdr_sub: str = jar.to_cookie_header("https://api.example.com/api")
nox.test.assert_true("domain_token=dom_tok_1" in hdr_sub, "api.example.com matches example.com")

# Exact domain accepted
hdr_exact: str = jar.to_cookie_header("https://example.com/api")
nox.test.assert_true("domain_token=dom_tok_1" in hdr_exact, "example.com exact match")

# Non-matching sibling domain REJECTED (CRITICAL FIX)
hdr_not: str = jar.to_cookie_header("https://notexample.com/api")
nox.test.assert_true("domain_token" not in hdr_not, "notexample.com rejected by domain boundary")

hdr_other: str = jar.to_cookie_header("https://evil-example.com/api")
nox.test.assert_true("domain_token" not in hdr_other, "evil-example.com rejected by domain boundary")

# 3. Path Isolation (RFC 6265 §5.1.4)
jar.set("admin_secret", "adm_999", "example.com", "/admin")

hdr_root: str = jar.to_cookie_header("https://example.com/dashboard")
nox.test.assert_true("admin_secret" not in hdr_root, "admin cookie not sent to /dashboard")

hdr_admin: str = jar.to_cookie_header("https://example.com/admin/settings")
nox.test.assert_true("admin_secret=adm_999" in hdr_admin, "admin cookie sent to /admin/settings")

# 4. Secure Cookie (Only sent over HTTPS)
jar.set("secure_auth", "sec_token_55", "example.com", "/", True, False)

hdr_http: str = jar.to_cookie_header("http://example.com/api")
nox.test.assert_true("secure_auth" not in hdr_http, "secure cookie NOT sent over unencrypted http://")

hdr_https: str = jar.to_cookie_header("https://example.com/api")
nox.test.assert_true("secure_auth=sec_token_55" in hdr_https, "secure cookie sent over https://")

# 5. Same name on different paths preserved without overwriting
jar.set("theme", "light", "example.com", "/")
jar.set("theme", "dark", "example.com", "/dashboard")

val_t1: str | None = jar.get("theme", "example.com", "/")
nox.test.assert_true(val_t1 is not None, "root theme is not None")
if val_t1 is not None:
    nox.test.assert_eq_str(val_t1, "light", "root theme is light")

val_t2: str | None = jar.get("theme", "example.com", "/dashboard")
nox.test.assert_true(val_t2 is not None, "dashboard theme is not None")
if val_t2 is not None:
    nox.test.assert_eq_str(val_t2, "dark", "dashboard theme is dark")

# 6. Extract Set-Cookie from response headers
resp_h: Headers = Headers()
resp_h.set("Set-Cookie", "auth_sess=sess_jwt_token_88; Domain=service.net; Path=/app; Secure; HttpOnly")

target_jar: CookieJar = CookieJar()
target_jar.extract_from_response("https://service.net/app/login", resp_h)
val_auth: str | None = target_jar.get("auth_sess")
nox.test.assert_true(val_auth is not None, "auth_sess is not None")
if val_auth is not None:
    nox.test.assert_eq_str(val_auth, "sess_jwt_token_88", "cookie value parsed from Set-Cookie")

# 7. Apply to request
req_h: Headers = Headers()
target_jar.apply_to_request("https://service.net/app/dashboard", req_h)
nox.test.assert_true(req_h.has("Cookie"), "Cookie header applied to request")
nox.test.assert_eq_str(req_h.get("Cookie"), "auth_sess=sess_jwt_token_88", "Cookie header value matches jar")

# 8. Semicolon or CRLF rejected in cookie token
bad_cookie_rejected: bool = False
try:
    jar.set("bad;name", "value")
except InvalidHeaderError as e:
    bad_cookie_rejected = True

nox.test.assert_true(bad_cookie_rejected, "semicolon in cookie name rejected")

# 9. Cookie Domain Acceptance Validation (RFC 6265 §5.3 Step 5) - P0 Fix
# Attacker on evil.example.net tries to set cookie for example.com
evil_resp: Headers = Headers()
evil_resp.set("Set-Cookie", "stolen_session=xyz123; Domain=example.com; Path=/")

victim_jar: CookieJar = CookieJar()
victim_jar.extract_from_response("https://evil.example.net/login", evil_resp)
nox.test.assert_true(victim_jar.get("stolen_session") is None, "unrelated origin cannot set cookie for example.com")
nox.test.assert_eq_int(victim_jar.len(), 0, "cookie rejected during extraction")

# Public Suffix (TLD) rejection (e.g. Domain=com)
tld_resp: Headers = Headers()
tld_resp.set("Set-Cookie", "super_sess=999; Domain=com; Path=/")
tld_jar: CookieJar = CookieJar()
tld_jar.extract_from_response("https://example.com/login", tld_resp)
nox.test.assert_true(tld_jar.get("super_sess") is None, "public suffix (com) rejected per RFC 6265")

# 10. Host-only Cookie Distinction (RFC 6265 §5.3 Step 6) - P0 Fix
# Server on api.example.com returns cookie without Domain= attribute
host_only_resp: Headers = Headers()
host_only_resp.set("Set-Cookie", "local_pref=dark; Path=/")
ho_jar: CookieJar = CookieJar()
ho_jar.extract_from_response("https://api.example.com/settings", host_only_resp)

# Sent to exact host
hdr_ho_exact: str = ho_jar.to_cookie_header("https://api.example.com/home")
nox.test.assert_true("local_pref=dark" in hdr_ho_exact, "host-only cookie sent to exact originating host")

# NOT sent to subdomain or sibling domain
hdr_ho_sub: str = ho_jar.to_cookie_header("https://sub.api.example.com/home")
nox.test.assert_true("local_pref" not in hdr_ho_sub, "host-only cookie NOT sent to subdomains")

hdr_ho_other: str = ho_jar.to_cookie_header("https://other.api.example.com/home")
nox.test.assert_true("local_pref" not in hdr_ho_other, "host-only cookie NOT sent to sibling domains")

print("cookies_test passed")
