# tests/unit/response_test.nox — Test Response status predicates, raise_for_status, and JSON decoding.

import nox.test
import response
from response import Response
import headers
from headers import Headers
import errors
from errors import HttpStatusError, DecodeError
import nox.json
from nox.json import JsonValue

# 1. Status classification predicates
empty_hdrs: Headers = Headers()
r200: Response = Response(200, "OK", empty_hdrs, "https://example.com", "GET", 15)
nox.test.assert_true(r200.is_success(), "200 is_success")
nox.test.assert_true(not r200.is_error(), "200 is not is_error")

r204: Response = Response(204, "", empty_hdrs, "https://example.com", "POST", 10)
nox.test.assert_true(r204.is_success(), "204 is_success")

r302: Response = Response(302, "", empty_hdrs, "https://example.com", "GET", 10)
nox.test.assert_true(r302.is_redirect(), "302 is_redirect")
nox.test.assert_true(not r302.is_success(), "302 not is_success")

r404: Response = Response(404, "Not Found", empty_hdrs, "https://example.com/missing", "GET", 20)
nox.test.assert_true(r404.is_client_error(), "404 is_client_error")
nox.test.assert_true(r404.is_error(), "404 is_error")

r500: Response = Response(500, "Crash", empty_hdrs, "https://example.com/err", "POST", 30)
nox.test.assert_true(r500.is_server_error(), "500 is_server_error")
nox.test.assert_true(r500.is_error(), "500 is_error")

# 2. raise_for_status() does not raise on 200
r200.raise_for_status()

# 3. raise_for_status() raises HttpStatusError on 4xx/5xx
caught_404: bool = False
try:
    r404.raise_for_status()
except HttpStatusError as he:
    caught_404 = True
    nox.test.assert_eq_int(he.status_code, 404, "status_code preserved in exception")
    nox.test.assert_eq_str(he.url, "https://example.com/missing", "url preserved in exception")

nox.test.assert_true(caught_404, "raise_for_status() raised on 404")

# 4. JSON parsing from response
valid_json_body: str = "{\"id\":101,\"name\":\"Nova\",\"active\":true}"
r_json: Response = Response(200, valid_json_body, empty_hdrs, "https://example.com/item", "GET", 12)
jv: JsonValue = r_json.json()
nox.test.assert_true(nox.json.is_object(jv), "parsed body is a JSON object")
nox.test.assert_eq_int(nox.json.object_len(jv), 3, "JSON object has 3 entries")

# 5. Malformed JSON raises DecodeError
bad_json_body: str = "{invalid json content"
r_bad_json: Response = Response(200, bad_json_body, empty_hdrs, "https://example.com/bad", "GET", 12)
caught_decode_err: bool = False
try:
    r_bad_json.json()
except DecodeError as de:
    caught_decode_err = True

nox.test.assert_true(caught_decode_err, "malformed JSON raises DecodeError")

# 6. Empty body raises DecodeError on json()
r_empty: Response = Response(204, "", empty_hdrs, "https://example.com/empty", "GET", 5)
caught_empty_err: bool = False
try:
    r_empty.json()
except DecodeError as de2:
    caught_empty_err = True

nox.test.assert_true(caught_empty_err, "empty response body raises DecodeError on json()")

print("response_test passed")
