# tests/unit/url_test.nox — Test URL resolution, query merging, fragment removal, and security validations.

import nox.test
import url
from url import resolve_url, sanitize_url
import errors
from errors import InvalidUrlError

# 1. Absolute URL resolution
res1: str = resolve_url("", "https://api.github.com/users", None)
nox.test.assert_eq_str(res1, "https://api.github.com/users", "absolute URL preserved without base_url")

# 2. Base URL + Relative path resolution (slash normalization)
res2: str = resolve_url("https://api.github.com", "/users", None)
nox.test.assert_eq_str(res2, "https://api.github.com/users", "base_url joined with leading slash path")

res3: str = resolve_url("https://api.github.com/", "users", None)
nox.test.assert_eq_str(res3, "https://api.github.com/users", "trailing slash on base handled")

res4: str = resolve_url("https://api.github.com/", "/users", None)
nox.test.assert_eq_str(res4, "https://api.github.com/users", "double slash normalized to single slash")

# 3. Relative URL without base_url raises InvalidUrlError
rel_rejected: bool = False
try:
    resolve_url("", "relative/endpoint", None)
except InvalidUrlError as e:
    rel_rejected = True

nox.test.assert_true(rel_rejected, "relative URL without base_url rejected")

# 4. Unsupported scheme rejected
scheme_rejected: bool = False
try:
    resolve_url("", "file:///etc/passwd", None)
except InvalidUrlError as e:
    scheme_rejected = True

nox.test.assert_true(scheme_rejected, "file:// scheme rejected")

ftp_rejected: bool = False
try:
    resolve_url("", "ftp://ftp.example.com/file.txt", None)
except InvalidUrlError as e:
    ftp_rejected = True

nox.test.assert_true(ftp_rejected, "ftp:// scheme rejected")

# 5. Query parameters appended and encoded
res_q: str = resolve_url("https://api.example.com", "/search", {"q": "hello world", "page": "2"})
nox.test.assert_true("q=hello" in res_q or "page=2" in res_q, "query parameters encoded into URL")

# 6. Existing query merged with params
res_q2: str = resolve_url("https://api.example.com", "/search?filter=active", {"limit": "50"})
nox.test.assert_true("filter=active" in res_q2 and "limit=50" in res_q2, "existing query parameters merged with params")

# 7. Fragment stripped from request target
res_frag: str = resolve_url("https://api.example.com", "/docs#section-3", None)
nox.test.assert_true("#" not in res_frag, "URL fragment stripped per RFC 7230 §5.1")

# 8. Embedded credentials in URL rejected
cred_rejected: bool = False
try:
    resolve_url("", "https://admin:super_secret@api.internal.com/data", None)
except InvalidUrlError as e:
    cred_rejected = True

nox.test.assert_true(cred_rejected, "embedded credentials in URL rejected for security")

# 9. Sanitization helper redacts passwords
safe: str = sanitize_url("https://bob:mysecretpassword@service.org/v1")
nox.test.assert_true("mysecretpassword" not in safe, "password redacted by sanitize_url")
nox.test.assert_true("bob:***@" in safe, "user preserved with redacted password")

# 10. IPv6 bracketed address preservation (P1)
res_ipv6: str = resolve_url("", "http://[::1]:8080/api/status", None)
nox.test.assert_eq_str(res_ipv6, "http://[::1]:8080/api/status", "IPv6 bracketed literal preserved")

res_ipv6_ssl: str = resolve_url("", "https://[2001:db8::1]/v1", {"debug": "1"})
nox.test.assert_true("https://[2001:db8::1]/v1?debug=1" in res_ipv6_ssl, "IPv6 with HTTPS and query params preserved")

# 11. RFC 3986 Path Normalization (.. and .) (P1)
res_dotdot: str = resolve_url("https://api.example.com/v1/", "../users", None)
nox.test.assert_eq_str(res_dotdot, "https://api.example.com/users", "RFC 3986 relative .. dot-segment resolved")

res_dots: str = resolve_url("https://api.example.com", "/a/b/./c/../../d", None)
nox.test.assert_eq_str(res_dots, "https://api.example.com/a/d", "multiple . and .. segments normalized")

print("url_test passed")
