# tests/unit/headers_test.nox — Test case-insensitive headers and CRLF injection defenses.

import nox.test
import headers
from headers import Headers, headers_from_dict
import errors
from errors import InvalidHeaderError

# 1. Case-insensitive lookup
h: Headers = Headers()
h.set("Content-Type", "application/json")
h.set("X-API-KEY", "secret-token-123")

nox.test.assert_eq_str(h.get("content-type"), "application/json", "lowercase lookup matches")
nox.test.assert_eq_str(h.get("CONTENT-TYPE"), "application/json", "uppercase lookup matches")
nox.test.assert_eq_str(h.get("Content-Type"), "application/json", "exact case lookup matches")
nox.test.assert_true(h.has("x-api-key"), "has() is case-insensitive")
nox.test.assert_true(h.has("X-Api-Key"), "has() works with mixed case")

# 2. Deletion
h.delete("x-api-key")
nox.test.assert_true(not h.has("X-API-KEY"), "deleted header not found")

# 3. CRLF injection protection in header name
crlf_name_rejected: bool = False
try:
    bad_h: Headers = Headers()
    bad_h.set("Injected\r\nHeader", "malicious_value")
except InvalidHeaderError as e:
    crlf_name_rejected = True

nox.test.assert_true(crlf_name_rejected, "CRLF in header name rejected")

# 4. CRLF injection protection in header value
crlf_val_rejected: bool = False
try:
    bad_h2: Headers = Headers()
    bad_h2.set("Valid-Name", "value\r\nInjected: true")
except InvalidHeaderError as e:
    crlf_val_rejected = True

nox.test.assert_true(crlf_val_rejected, "CRLF in header value rejected")

# 5. Empty header name rejected
empty_name_rejected: bool = False
try:
    bad_h3: Headers = Headers()
    bad_h3.set("", "some_value")
except InvalidHeaderError as e:
    empty_name_rejected = True

nox.test.assert_true(empty_name_rejected, "Empty header name rejected")

# 5b. RFC 7230 token validation: Space, Colon, and Slash in header name rejected
space_name_rejected: bool = False
try:
    bad_h_space: Headers = Headers()
    bad_h_space.set("Bad Header", "value")
except InvalidHeaderError as e:
    space_name_rejected = True
nox.test.assert_true(space_name_rejected, "Space in header name rejected")

colon_name_rejected: bool = False
try:
    bad_h_colon: Headers = Headers()
    bad_h_colon.set("X-Test:Injected", "value")
except InvalidHeaderError as e:
    colon_name_rejected = True
nox.test.assert_true(colon_name_rejected, "Colon in header name rejected")

slash_name_rejected: bool = False
try:
    bad_h_slash: Headers = Headers()
    bad_h_slash.set("Header/Name", "value")
except InvalidHeaderError as e:
    slash_name_rejected = True
nox.test.assert_true(slash_name_rejected, "Slash in header name rejected")

# 6. Cloning isolation
orig: Headers = Headers()
orig.set("Authorization", "Bearer tok1")
copy_h: Headers = orig.clone()
copy_h.set("Authorization", "Bearer tok2")
nox.test.assert_eq_str(orig.get("Authorization"), "Bearer tok1", "original unchanged by clone mutation")
nox.test.assert_eq_str(copy_h.get("Authorization"), "Bearer tok2", "clone reflects mutation")

# 7. Merge dictionary
merged: Headers = Headers()
merged.set("User-Agent", "Nova/0.1.0")
merged.set("Accept", "*/*")
merged.merge_dict({"Accept": "application/json", "X-Trace": "12345"})
nox.test.assert_eq_str(merged.get("Accept"), "application/json", "merged dict overrides existing key")
nox.test.assert_eq_str(merged.get("X-Trace"), "12345", "merged dict adds new key")
nox.test.assert_eq_str(merged.get("User-Agent"), "Nova/0.1.0", "untouched key preserved")

# 8. Control characters in header value rejected per RFC 7230 §3.2
lf_rejected: bool = False
try:
    bad_ctrl: Headers = Headers()
    bad_ctrl.set("X-Custom", "val\nue")
except InvalidHeaderError as e:
    lf_rejected = True
nox.test.assert_true(lf_rejected, "LF control character in header value rejected")

# Tab (0x09) is allowed in header value per RFC 7230 §3.2
valid_tab: Headers = Headers()
valid_tab.set("X-Tabbed", "val\tue")
nox.test.assert_eq_str(valid_tab.get("X-Tabbed"), "val\tue", "HTAB allowed in header value")

print("headers_test passed")
