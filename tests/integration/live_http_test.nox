# tests/integration/live_http_test.nox — End-to-end integration test with live HTTP calls.

import nox.test
import nova
from nova import Client, Response
import errors
from errors import HttpStatusError
import nox.json
from nox.json import JsonValue

cli: Client = Client("https://httpbin.org")

# 1. Live GET with query params and custom headers
resp_get: Response = cli.get("/get", {"test_key": "test_val"}, {"X-Nova-Test": "Integration-1.0"})
nox.test.assert_eq_int(resp_get.status_code, 200, "live GET status is 200")
nox.test.assert_true(resp_get.is_success(), "live GET is_success")
nox.test.assert_true(len(resp_get.body) > 0, "live GET returns body")

# 2. JSON Parsing
parsed_json: JsonValue = resp_get.json()
nox.test.assert_true(nox.json.is_object(parsed_json), "parsed GET body is JSON object")

# 3. Live POST JSON
resp_post: Response = cli.post_json("/post", "{\"framework\":\"nova\",\"type\":\"http_client\"}")
nox.test.assert_eq_int(resp_post.status_code, 200, "live POST status is 200")
nox.test.assert_true(resp_post.is_success(), "live POST is_success")

# 4. Live POST Form
resp_form: Response = cli.post_form("/post", {"user": "nox_user", "action": "login"})
nox.test.assert_eq_int(resp_form.status_code, 200, "live POST form status is 200")
nox.test.assert_true(resp_form.is_success(), "live POST form is_success")

# 5. Live 404 & raise_for_status()
resp_404: Response = cli.get("/status/404")
nox.test.assert_eq_int(resp_404.status_code, 404, "status 404 returned")
nox.test.assert_true(resp_404.is_client_error(), "404 is client error")
nox.test.assert_true(not resp_404.is_success(), "404 is not success")

caught_404_exc: bool = False
try:
    resp_404.raise_for_status()
except HttpStatusError as he:
    caught_404_exc = True
    nox.test.assert_eq_int(he.status_code, 404, "status 404 in exception")

nox.test.assert_true(caught_404_exc, "raise_for_status() raises on live 404")

print("live_http_test passed")
