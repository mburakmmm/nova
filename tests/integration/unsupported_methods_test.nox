# tests/integration/unsupported_methods_test.nox — Verifies explicit UnsupportedFeatureError on unrecognized/unsupported HTTP methods.

import nox.test
import nova
from nova import Client, Response
import errors
from errors import UnsupportedFeatureError

cli: Client = Client("https://httpbin.org")

# 1. Unrecognized custom method is explicitly rejected
custom_rejected: bool = False
try:
    cli.request("PROPFIND", "/get")
except UnsupportedFeatureError as ue:
    custom_rejected = True
    nox.test.assert_eq_str(ue.feature, "PROPFIND", "unsupported method reported in UnsupportedFeatureError")

nox.test.assert_true(custom_rejected, "unrecognized method raises UnsupportedFeatureError")

# 2. Another non-standard method is explicitly rejected
trace_rejected: bool = False
try:
    cli.request("TRACE", "/get")
except UnsupportedFeatureError as te:
    trace_rejected = True
    nox.test.assert_eq_str(te.feature, "TRACE", "TRACE reported in UnsupportedFeatureError")

nox.test.assert_true(trace_rejected, "TRACE raises UnsupportedFeatureError")

print("unsupported_methods_test passed")
