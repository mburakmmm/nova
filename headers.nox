# headers.nox — Case-insensitive HTTP header collection with RFC 7230 token validation and CRLF defense.

import errors
from errors import InvalidHeaderError
import nox.strings

def _is_rfc_token_char(b: int) -> bool:
    # RFC 7230 §3.2.6: tchar = "!" / "#" / "$" / "%" / "&" / "'" / "*" / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~" / DIGIT / ALPHA
    # DIGIT (0-9)
    if b >= 48 and b <= 57:
        return True
    # ALPHA (A-Z)
    if b >= 65 and b <= 90:
        return True
    # ALPHA (a-z)
    if b >= 97 and b <= 122:
        return True
    # Punctuation
    if b == 33 or b == 35 or b == 36 or b == 37 or b == 38 or b == 39:
        return True
    if b == 42 or b == 43 or b == 45 or b == 46 or b == 94 or b == 95 or b == 96:
        return True
    if b == 124 or b == 126:
        return True
    return False

def validate_header_entry(name: str, value: str) -> None:
    if len(name) == 0:
        raise InvalidHeaderError("Header name cannot be empty")

    # Validate header name token characters (rejects spaces, colons, slashes, control chars, CRLF)
    i: int = 0
    n: int = len(name)
    while i < n:
        b: int = nox.strings.byte_at(name, i)
        if not _is_rfc_token_char(b):
            raise InvalidHeaderError("Header name '" + name + "' contains invalid character per RFC 7230")
        i = i + 1

    # Validate header value characters (rejects CR, LF, NUL)
    j: int = 0
    m: int = len(value)
    while j < m:
        vb: int = nox.strings.byte_at(value, j)
        if vb == 13 or vb == 10 or vb == 0:
            raise InvalidHeaderError("Header value contains forbidden CR/LF/NUL characters for header: " + name)
        j = j + 1

class Headers:
    entries: dict[str, str]
    display_names: dict[str, str]

    def __init__(self: Headers) -> None:
        self.entries = {}
        self.display_names = {}

    def set(self: Headers, name: str, value: str) -> None:
        validate_header_entry(name, value)
        low: str = nox.strings.lower(name)
        self.entries[low] = value
        self.display_names[low] = name

    def get(self: Headers, name: str, default: str = "") -> str:
        low: str = nox.strings.lower(name)
        if low in self.entries:
            return self.entries[low]
        return default

    def get_opt(self: Headers, name: str) -> str | None:
        low: str = nox.strings.lower(name)
        if low in self.entries:
            return self.entries[low]
        return None

    def has(self: Headers, name: str) -> bool:
        low: str = nox.strings.lower(name)
        return low in self.entries

    def delete(self: Headers, name: str) -> None:
        low: str = nox.strings.lower(name)
        if low in self.entries:
            del self.entries[low]
            del self.display_names[low]

    def len(self: Headers) -> int:
        return len(self.entries)

    def merge_dict(self: Headers, extra: dict[str, str]) -> None:
        for k in extra:
            self.set(k, extra[k])

    def to_dict(self: Headers) -> dict[str, str]:
        out: dict[str, str] = {}
        for low in self.entries:
            orig_name: str = self.display_names[low]
            out[orig_name] = self.entries[low]
        return out

    def clone(self: Headers) -> Headers:
        h: Headers = Headers()
        for low in self.entries:
            orig_name: str = self.display_names[low]
            val: str = self.entries[low]
            h.set(orig_name, val)
        return h

def headers_from_dict(d: dict[str, str]) -> Headers:
    h: Headers = Headers()
    for k in d:
        h.set(k, d[k])
    return h
