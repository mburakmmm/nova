# request.nox — Canonical HTTP request representation.

import headers
from headers import Headers

class Request:
    method: str
    url: str
    headers: Headers
    body: str
    timeout_ms: int
    connect_ip: str
    ca_file: str

    def __init__(
        self: Request,
        method: str,
        url: str,
        headers: Headers,
        body: str = "",
        timeout_ms: int = 0,
        connect_ip: str = "",
        ca_file: str = ""
    ) -> None:
        self.method = method
        self.url = url
        self.headers = headers
        self.body = body
        self.timeout_ms = timeout_ms
        self.connect_ip = connect_ip
        self.ca_file = ca_file
