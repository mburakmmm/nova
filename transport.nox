# transport.nox — Transport adapter wrapping nox.http stdlib interface.

import nox.http
from nox.http import HttpResponse, HttpError, HttpTimeoutError
import nox.time
import request
from request import Request
import response
from response import Response
import headers
from headers import Headers, headers_from_dict
import errors
from errors import TransportError, TimeoutError, UnsupportedFeatureError
import url
from url import sanitize_url

class TransportAdapter:
    def __init__(self: TransportAdapter) -> None:
        pass

    def execute(self: TransportAdapter, req: Request) -> Response:
        method: str = req.method
        target_url: str = req.url
        raw_headers: dict[str, str] = req.headers.to_dict()

        if method == "GET" or method == "POST" or method == "PUT" or method == "PATCH" or method == "DELETE" or method == "HEAD" or method == "OPTIONS":
            start_ms: int = nox.time.now_ms()
            try:
                res: HttpResponse = nox.http.request(method, target_url, req.body, raw_headers, req.timeout_ms)
                elapsed: int = nox.time.now_ms() - start_ms
                resp_headers: Headers = headers_from_dict(res.headers)
                return Response(res.status, res.body, resp_headers, target_url, method, elapsed)
            except HttpTimeoutError as te:
                raise TimeoutError("Request timed out after " + str(req.timeout_ms) + " ms for " + method + " " + sanitize_url(target_url) + ": " + str(te))
            except HttpError as e:
                raise TransportError(method + " request failed for " + sanitize_url(target_url) + ": " + str(e))

        raise UnsupportedFeatureError(method, "Unrecognized HTTP method: " + method)
