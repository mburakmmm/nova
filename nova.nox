def request(
    method: str,
    url_target: str,
    body: str = "",
    json: str = "",
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None,
    timeout_ms: int = -1
) -> Response:
    c: Client = Client()
    return c.request(method, url_target, body, json, params, headers_dict, timeout_ms)

def get(
    url_target: str,
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None,
    timeout_ms: int = -1
) -> Response:
    c: Client = Client()
    return c.get(url_target, params, headers_dict, timeout_ms)

def post(
    url_target: str,
    body: str = "",
    json: str = "",
    params: dict[str, str] | None = None,
