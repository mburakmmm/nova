# nova.nox — Top-level facade for the Nova HTTP client library.

import errors
from errors import NovaError, TransportError, ConnectionError, HttpStatusError, InvalidUrlError, InvalidHeaderError, DecodeError, EncodeError, RetryExhaustedError, UnsupportedFeatureError
import headers
from headers import Headers, headers_from_dict
import url
from url import resolve_url, sanitize_url
import auth
from auth import BasicAuth, BearerAuth
import cookies
from cookies import CookieJar
import retry
from retry import RetryPolicy
import response
from response import Response
import request
from request import Request
import transport
from transport import TransportAdapter
import client
from client import Client

def get(
    url_target: str,
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.get(url_target, params, headers_dict)

def post(
    url_target: str,
    body: str = "",
    json: str = "",
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.post(url_target, body, json, params, headers_dict)

def post_json(
    url_target: str,
    json_str: str,
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.post_json(url_target, json_str, params, headers_dict)

def post_form(
    url_target: str,
    data: dict[str, str],
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.post_form(url_target, data, params, headers_dict)

def put(
    url_target: str,
    body: str = "",
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.put(url_target, body, params, headers_dict)

def patch(
    url_target: str,
    body: str = "",
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.patch(url_target, body, params, headers_dict)

def delete(
    url_target: str,
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None
) -> Response:
    c: Client = Client()
    return c.delete(url_target, params, headers_dict)
