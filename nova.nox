# nova.nox — Top-level facade for the Nova HTTP client library.

import errors
from errors import NovaError, TransportError, ConnectionError, TimeoutError, HttpStatusError, InvalidUrlError, InvalidHeaderError, DecodeError, EncodeError, RetryExhaustedError, UnsupportedFeatureError
import headers
from headers import Headers, headers_from_dict
import url
from url import resolve_url, sanitize_url
import auth
from auth import BasicAuth, BearerAuth
import cookies
from cookies import CookieJar, Cookie
import retry
from retry import RetryPolicy
import response
from response import Response
import request
from request import Request
import transport
from transport import TransportAdapter
import multipart
from multipart import MultipartEncoder, MultipartFile, file_from_path
import client
from client import Client

def request(
    method: str,
    url_target: str,
    body: str = "",
    json: str = "",
    params: dict[str, str] | None = None,
    headers_dict: dict[str, str] | None = None,
    timeout_ms: int = -1
) -> Response:
    c: Client = Client()
    return c.request(method, url_target, body, json, params, headers_dict, timeout_ms)

