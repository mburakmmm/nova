# stream.nox — Streaming response & upload models per AGENTS.md §16.

import nox.http
from nox.http import HttpStream, HttpError, HttpTimeoutError
import nox.time
import headers
from headers import Headers, response_headers_from_dict
import cookies
from cookies import CookieJar
import codec
from codec import ContentDecoder, decode_response_with
import response
from response import Response
import errors
from errors import HttpStatusError, DecodeError, TransportError, TimeoutError, EncodeError
import url
from url import sanitize_url
import nox.bytes
from nox.buffer import Buffer
import nox.strings

# Callback-style consumers (Nox has no lazy iterators yet, see NOX_LIMITATIONS.md §15).
# Subclass and override; return False from on_* to stop early.
class LineHandler:
    def on_line(self: LineHandler, line: str) -> bool:
        return True

class ChunkHandler:
    def on_chunk(self: ChunkHandler, chunk: str) -> bool:
        return True

class StreamResponse:
    status_code: int
    headers: Headers
    url: str
    method: str
    raw_body: str
    cursor: int
    is_closed: bool
    native_stream: HttpStream | None
    line_buf: str
    max_line_bytes: int

    def __init__(
        self: StreamResponse,
        status_code: int,
        headers: Headers,
        url: str,
        method: str,
        raw_body: str = "",
        native_stream: HttpStream | None = None
    ) -> None:
        self.status_code = status_code
        self.headers = headers
        self.url = url
        self.method = method
        self.raw_body = raw_body
        self.cursor = 0
        self.is_closed = False
        self.native_stream = native_stream
        self.line_buf = ""
        self.max_line_bytes = 1048576

    def is_success(self: StreamResponse) -> bool:
        return self.status_code >= 200 and self.status_code <= 299

    def is_error(self: StreamResponse) -> bool:
        return self.status_code >= 400

    def raise_for_status(self: StreamResponse) -> None:
        if self.is_error():
            safe: str = sanitize_url(self.url)
            msg: str = "HTTP " + str(self.status_code) + " error for url: " + safe
            raise HttpStatusError(self.status_code, self.url, msg)

    def read_chunk(self: StreamResponse, chunk_size: int = 4096) -> str:
        if self.is_closed:
            return ""
        if chunk_size <= 0:
            chunk_size = 4096

        ns: HttpStream | None = self.native_stream
        if ns is not None:
            c: str = ns.read_chunk(chunk_size)
            if len(c) == 0:
                self.is_closed = True
            return c

        total: int = len(self.raw_body)
        if self.cursor >= total:
            return ""

        end_pos: int = self.cursor + chunk_size
        if end_pos > total:
            end_pos = total

        chunk: str = self.raw_body[self.cursor:end_pos]
        self.cursor = end_pos
        return chunk

    def read_chunk_bytes(self: StreamResponse, chunk_size: int = 4096) -> Buffer:
        chunk_str: str = self.read_chunk(chunk_size)
        return nox.bytes.from_str(chunk_str)

    # TRULY LAZY: returns the next line (without \n / \r\n) or None at EOF. Memory is bounded by
    # one chunk plus the current line; a line longer than max_line_bytes raises DecodeError.
    def read_line(self: StreamResponse) -> str | None:
        while True:
            nl: int = nox.strings.index_of(self.line_buf, "\n")
            if nl >= 0:
                line: str = self.line_buf[0:nl]
                self.line_buf = self.line_buf[nl + 1:]
                if len(line) > 0 and line[len(line) - 1:] == "\r":
                    line = line[0:len(line) - 1]
                line_bytes: int = nox.strings.byte_len(line)
                if line_bytes > self.max_line_bytes:
                    raise DecodeError("Line exceeds max_line_bytes (" + str(self.max_line_bytes) + "): " + str(line_bytes) + " bytes")
                return line
            if nox.strings.byte_len(self.line_buf) > self.max_line_bytes:
                raise DecodeError("Line exceeds max_line_bytes (" + str(self.max_line_bytes) + ")")
            part: str = self.read_chunk(4096)
            if len(part) == 0:
                if len(self.line_buf) > 0:
                    rest: str = self.line_buf
                    self.line_buf = ""
                    if rest[len(rest) - 1:] == "\r":
                        rest = rest[0:len(rest) - 1]
                    rest_bytes: int = nox.strings.byte_len(rest)
                    if rest_bytes > self.max_line_bytes:
                        raise DecodeError("Line exceeds max_line_bytes (" + str(self.max_line_bytes) + "): " + str(rest_bytes) + " bytes")
                    return rest
                return None
            self.line_buf = self.line_buf + part
        return None

    # Lazily yields each line (without \n / \r\n) on demand with bounded chunk memory.
    def lines(self: StreamResponse) -> Iterator[str]:
        while True:
            ln: str | None = self.read_line()
            if ln is None:
                break
            yield ln

    # Lazily yields response chunks of up to `chunk_size` bytes on demand.
    def chunks(self: StreamResponse, chunk_size: int = 4096) -> Iterator[str]:
        while True:
            c: str = self.read_chunk(chunk_size)
            if len(c) == 0:
                break
            yield c

    # Lazy, bounded-memory line consumption (SSE, log streams, NDJSON, huge text bodies).
    def for_each_line(self: StreamResponse, handler: LineHandler) -> int:
        count: int = 0
        while True:
            ln: str | None = self.read_line()
            if ln is None:
                break
            count = count + 1
            if not handler.on_line(ln):
                break
        return count

    # Lazy, bounded-memory chunk consumption.
    def for_each_chunk(self: StreamResponse, handler: ChunkHandler, chunk_size: int = 4096) -> int:
        total: int = 0
        while True:
            c: str = self.read_chunk(chunk_size)
            if len(c) == 0:
                break
            total = total + len(c)
            if not handler.on_chunk(c):
                break
        return total

    # NOTE: buffers EVERY remaining chunk in memory. Use for_each_chunk() for large bodies.
    def iter_bytes(self: StreamResponse, chunk_size: int = 4096) -> list[Buffer]:
        chunks: list[Buffer] = []
        while True:
            b: Buffer = self.read_chunk_bytes(chunk_size)
            if b.len() == 0:
                break
            chunks.append(b)
        return chunks

    # NOTE: buffers the WHOLE remaining body before splitting. Use read_line() / for_each_line()
    # for lazy, bounded-memory consumption.
    def iter_lines(self: StreamResponse) -> list[str]:
        if self.is_closed:
            return []
        ns: HttpStream | None = self.native_stream
        if ns is not None:
            full: str = self.read_all()
            lines: list[str] = nox.strings.split(full, "\n")
            return lines

        lines: list[str] = nox.strings.split(self.raw_body, "\n")
        self.cursor = len(self.raw_body)
        return lines

    def read_all(self: StreamResponse) -> str:
        if self.is_closed:
            return ""
        ns: HttpStream | None = self.native_stream
        if ns is not None:
            res: str = ""
            while True:
                part: str = self.read_chunk(65536)
                if len(part) == 0:
                    break
                res = res + part
            self.is_closed = True
            return res

        remaining: str = self.raw_body[self.cursor:]
        self.cursor = len(self.raw_body)
        return remaining

    def close(self: StreamResponse) -> None:
        if not self.is_closed:
            self.is_closed = True
            self.cursor = len(self.raw_body)
            ns: HttpStream | None = self.native_stream
            if ns is not None:
                ns.close()

    def __enter__(self: StreamResponse) -> StreamResponse:
        return self

    def __exit__(self: StreamResponse) -> None:
        self.close()

# Streaming request upload wrapper over `nox.http.HttpStream` (`stream_upload`).
# Supports incremental chunked (`content_length=-1`) or fixed-length uploads without buffering the request body.
class UploadStream:
    url: str
    method: str
    content_length: int
    bytes_sent: int
    is_finished: bool
    is_closed: bool
    raise_on_status: bool
    cookie_jar: CookieJar | None
    content_decoder: ContentDecoder | None
    native_stream: HttpStream | None
    mock_status: int
    mock_headers: Headers
    mock_body: str
    uploaded_buf: str
    start_ms: int

    def __init__(
        self: UploadStream,
        url: str,
        method: str,
        content_length: int = -1,
        native_stream: HttpStream | None = None,
        mock_status: int = 200,
        mock_headers: Headers | None = None,
        mock_body: str = "",
        raise_on_status: bool = False
    ) -> None:
        self.url = url
        self.method = method
        self.content_length = content_length
        self.bytes_sent = 0
        self.is_finished = False
        self.is_closed = False
        self.raise_on_status = raise_on_status
        self.cookie_jar = None
        self.content_decoder = None
        self.native_stream = native_stream
        self.mock_status = mock_status
        if mock_headers is not None:
            self.mock_headers = mock_headers
        else:
            self.mock_headers = Headers()
        self.mock_body = mock_body
        self.uploaded_buf = ""
        self.start_ms = nox.time.now_ms()

    def write(self: UploadStream, chunk: str) -> None:
        if self.is_closed:
            raise TransportError("UploadStream is already closed for " + sanitize_url(self.url))
        if self.is_finished:
            raise TransportError("UploadStream is already finished for " + sanitize_url(self.url))
        chunk_bytes: int = nox.strings.byte_len(chunk)
        if self.content_length >= 0 and self.bytes_sent + chunk_bytes > self.content_length:
            raise EncodeError("Upload write (" + str(self.bytes_sent + chunk_bytes) + " bytes) exceeds declared content_length (" + str(self.content_length) + " bytes)")
        if chunk_bytes == 0:
            return
        ns: HttpStream | None = self.native_stream
        if ns is not None:
            try:
                ns.write(chunk)
            except HttpTimeoutError as te:
                self.is_closed = True
                raise TimeoutError("Upload write timed out for " + self.method + " " + sanitize_url(self.url) + ": " + str(te)) from te
            except HttpError as e:
                self.is_closed = True
                raise TransportError("Upload write failed for " + self.method + " " + sanitize_url(self.url) + ": " + str(e)) from e
        else:
            self.uploaded_buf = self.uploaded_buf + chunk
        self.bytes_sent = self.bytes_sent + chunk_bytes

    def write_bytes(self: UploadStream, buf: Buffer) -> None:
        self.write(nox.bytes.to_str(buf))

    def _finalize_stream_response(self: UploadStream, s_resp: StreamResponse) -> StreamResponse:
        try:
            jar: CookieJar | None = self.cookie_jar
            if jar is not None:
                jar.extract_from_response(self.url, s_resp.headers)
            if self.raise_on_status:
                s_resp.raise_for_status()
            return s_resp
        except Exception as err:
            s_resp.close()
            self.is_closed = True
            raise err

    def finish_stream(self: UploadStream) -> StreamResponse:
        if self.is_closed:
            raise TransportError("UploadStream is already closed for " + sanitize_url(self.url))
        if self.is_finished:
            raise TransportError("UploadStream has already been finished for " + sanitize_url(self.url))
        if self.content_length >= 0 and self.bytes_sent != self.content_length:
            self.close()
            raise EncodeError("Upload finished with " + str(self.bytes_sent) + " bytes, expected content_length=" + str(self.content_length))

        self.is_finished = True
        ns: HttpStream | None = self.native_stream
        if ns is not None:
            try:
                ns.finish()
                resp_headers: Headers = response_headers_from_dict(ns.headers)
                s_resp: StreamResponse = StreamResponse(ns.status, resp_headers, self.url, self.method, "", ns)
                return self._finalize_stream_response(s_resp)
            except HttpTimeoutError as te:
                self.close()
                raise TimeoutError("Upload finish timed out for " + self.method + " " + sanitize_url(self.url) + ": " + str(te)) from te
            except HttpError as e:
                self.close()
                raise TransportError("Upload finish failed for " + self.method + " " + sanitize_url(self.url) + ": " + str(e)) from e

        s_mock: StreamResponse = StreamResponse(self.mock_status, self.mock_headers.clone(), self.url, self.method, self.mock_body, None)
        return self._finalize_stream_response(s_mock)

    def finish(self: UploadStream) -> Response:
        try:
            s_resp: StreamResponse = self.finish_stream()
            try:
                body: str = s_resp.read_all()
                s_resp.close()
                self.is_closed = True
                elapsed: int = nox.time.now_ms() - self.start_ms
                final_res: Response = Response(s_resp.status_code, body, s_resp.headers, self.url, self.method, elapsed)
                dec: ContentDecoder | None = self.content_decoder
                if dec is not None:
                    final_res = decode_response_with(final_res, dec, True)
                return final_res
            except Exception as inner_err:
                s_resp.close()
                raise inner_err
        except Exception as err:
            self.close()
            raise err

    # Recorded bytes written when backed by MockTransport (empty on native sockets to keep zero-buffer streaming).
    def uploaded_data(self: UploadStream) -> str:
        return self.uploaded_buf

    def close(self: UploadStream) -> None:
        if not self.is_closed:
            self.is_closed = True
            ns: HttpStream | None = self.native_stream
            if ns is not None:
                ns.close()

    def __enter__(self: UploadStream) -> UploadStream:
        return self

    def __exit__(self: UploadStream) -> None:
        self.close()

